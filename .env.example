# Port configuration
PORT=3001
VITE_API_URL=http://localhost:3001

# Optional Carrier API tokens
# Delhivery token (optional - public fallback works without credentials)
DELHIVERY_API_TOKEN=

# Android push notifications (Firebase Cloud Messaging)
# Provide EITHER the raw service-account JSON or a path to the JSON file.
# Create one in Firebase Console > Project settings > Service accounts.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# Telegram Bot integration (optional)
TELEGRAM_BOT_TOKEN=

# Dropbox API Database Persistence (for Render / ephemeral disk deployments)
# Obtain from https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_PATH=/posttrack/posttrack.db
